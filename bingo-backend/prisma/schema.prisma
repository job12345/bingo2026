// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  player
  admin
  bot
}

enum TransactionType {
  deposit
  withdraw
  card_purchase
  payout
  refund
  fee
}

enum TransactionStatus {
  pending
  completed
  rejected
  cancelled
}

enum GameState {
  idle
  waiting
  sitting
  buying
  running
  bingo_race
  winner_declared
  payout
  cooldown
}

enum DrawMode {
  auto
  manual_rotate
}

enum BallSet {
  BALL_75  @map("75")
  BALL_90  @map("90")
}

// ==========================================
// MODELS
// ==========================================

// ------------------------------------------
// Users & Authentication
// ------------------------------------------

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Authentication Methods
  phoneNumber String?  @unique @map("phone_number") @db.VarChar(15)
  password    String?
  googleId    String?  @unique @map("google_id")
  email       String?  @unique

  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  role        UserRole @default(player)

  // Wallet
  pointBalance Decimal @default(0.00) @map("point_balance") @db.Decimal(12, 2)

  // Bank Info
  bankName          String? @map("bank_name")
  bankAccountNumber String? @map("bank_account_number")
  bankAccountName   String? @map("bank_account_name")

  // Statistics
  totalGamesPlayed Int     @default(0) @map("total_games_played")
  totalWins        Int     @default(0) @map("total_wins")
  totalSpent       Decimal @default(0.00) @map("total_spent") @db.Decimal(12, 2)
  totalWon         Decimal @default(0.00) @map("total_won") @db.Decimal(12, 2)

  // Security
  isBanned     Boolean   @default(false) @map("is_banned")
  bannedReason String?   @map("banned_reason")
  bannedUntil  DateTime? @map("banned_until")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Relations
  sessions            Session[]
  transactions        Transaction[]        @relation("UserTransactions")
  approvedTransactions Transaction[]       @relation("ApprovedTransactions")
  createdRooms        Room[]               @relation("RoomCreator")
  wonRooms            Room[]               @relation("TopWinner")
  wonGames            Game[]               @relation("GameWinner")
  gameParticipants    GameParticipant[]
  cards               Card[]
  bingoRequests       BingoRequest[]
  botConfig           BotConfig?
  chatMessages        ChatMessage[]
  auditLogs           AuditLog[]
  updatedSettings     SystemSetting[]
  userAchievements    UserAchievement[]
  
  // Referral System
  referralCode        String?  @unique @map("referral_code") @db.VarChar(10)
  referredById        String?  @map("referred_by_id") @db.Uuid
  referredBy          User?    @relation("ReferralRelation", fields: [referredById], references: [id])
  referrals           User[]   @relation("ReferralRelation")
  referralRecords     Referral[] @relation("ReferrerRecords")
  referredRecords     Referral[] @relation("RefereeRecords")

  @@index([phoneNumber])
  @@index([googleId])
  @@index([email])
  @@index([role])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @map("refresh_token")
  deviceInfo   Json?    @map("device_info")
  ipAddress    String?  @map("ip_address") @db.Inet
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

// ------------------------------------------
// Financial System
// ------------------------------------------

model Transaction {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  type           TransactionType
  amount         Decimal           @db.Decimal(12, 2)
  status         TransactionStatus @default(pending)
  balanceBefore  Decimal           @map("balance_before") @db.Decimal(12, 2)
  balanceAfter   Decimal           @map("balance_after") @db.Decimal(12, 2)
  paymentSlipUrl String?           @map("payment_slip_url")
  bankTransferId String?           @map("bank_transfer_id")
  approvedBy     String?           @map("approved_by") @db.Uuid
  approvedAt     DateTime?         @map("approved_at")
  rejectionReason String?          @map("rejection_reason")
  metadata       Json?
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user     User  @relation("UserTransactions", fields: [userId], references: [id], onDelete: Restrict)
  approver User? @relation("ApprovedTransactions", fields: [approvedBy], references: [id])

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@map("transactions")
}

// ------------------------------------------
// Game System
// ------------------------------------------

model Room {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  creatorId         String?   @map("creator_id") @db.Uuid
  drawMode          DrawMode  @default(auto) @map("draw_mode")
  ballSet           BallSet   @default(BALL_75) @map("ball_set")
  maxPlayers        Int       @default(10) @map("max_players")
  maxRounds         Int       @default(50) @map("max_rounds")
  cardPrice         Decimal   @map("card_price") @db.Decimal(10, 2)
  maxCardsPerPlayer Int       @default(4) @map("max_cards_per_player")
  feePercentage     Decimal   @default(10.00) @map("fee_percentage") @db.Decimal(5, 2)

  // Statistics
  currentRound        Int     @default(0) @map("current_round")
  totalRoundsPlayed   Int     @default(0) @map("total_rounds_played")
  totalPotCollected   Decimal @default(0.00) @map("total_pot_collected") @db.Decimal(12, 2)
  totalFeeCollected   Decimal @default(0.00) @map("total_fee_collected") @db.Decimal(12, 2)
  topWinnerId         String? @map("top_winner_id") @db.Uuid
  topWinnerAmount     Decimal @default(0.00) @map("top_winner_amount") @db.Decimal(12, 2)

  // State
  currentState GameState @default(idle) @map("current_state")
  isActive     Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator   User?         @relation("RoomCreator", fields: [creatorId], references: [id])
  topWinner User?         @relation("TopWinner", fields: [topWinnerId], references: [id])
  games     Game[]
  chatMessages ChatMessage[]

  @@index([isActive])
  @@index([currentState])
  @@index([creatorId])
  @@map("rooms")
}

model Game {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String    @map("room_id") @db.Uuid
  roundNumber     Int       @map("round_number")
  state           GameState @default(waiting)
  drawnNumbers    Int[]     @map("drawn_numbers")
  currentBall     Int?      @map("current_ball")
  totalBallsDrawn Int       @default(0) @map("total_balls_drawn")

  // Financial
  potSize       Decimal @default(0.00) @map("pot_size") @db.Decimal(12, 2)
  feeAmount     Decimal @default(0.00) @map("fee_amount") @db.Decimal(12, 2)
  payoutAmount  Decimal @default(0.00) @map("payout_amount") @db.Decimal(12, 2)

  // Winner
  winnerId       String? @map("winner_id") @db.Uuid
  winnerCardId   String? @map("winner_card_id") @db.Uuid
  winningPattern String? @map("winning_pattern")
  ballsToWin     Int?    @map("balls_to_win")

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  room         Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winner       User?             @relation("GameWinner", fields: [winnerId], references: [id])
  participants GameParticipant[]
  cards        Card[]
  bingoRequests BingoRequest[]

  @@index([roomId])
  @@index([state])
  @@index([winnerId])
  @@index([createdAt(sort: Desc)])
  @@index([roomId, state, createdAt(sort: Desc)])
  @@map("games")
}

model GameParticipant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId      String   @map("game_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  isSpectator Boolean  @default(false) @map("is_spectator")
  cardsBought Int      @default(0) @map("cards_bought")
  totalSpent  Decimal  @default(0.00) @map("total_spent") @db.Decimal(10, 2)
  joinedAt    DateTime @default(now()) @map("joined_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([gameId])
  @@index([userId])
  @@unique([gameId, userId])
  @@map("game_participants")
}

model Card {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId          String   @map("game_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  numbers         Json
  cardHash        String   @unique @map("card_hash")
  markedPositions Json     @default("[]") @map("marked_positions")
  isWinner        Boolean  @default(false) @map("is_winner")
  purchasePrice   Decimal  @map("purchase_price") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  game          Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  bingoRequests BingoRequest[]

  @@index([gameId])
  @@index([userId])
  @@index([cardHash])
  @@index([userId, gameId])
  @@map("cards")
}

model BingoRequest {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId             String   @map("game_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  cardId             String   @map("card_id") @db.Uuid
  claimedPattern     String   @map("claimed_pattern")
  isValid            Boolean  @map("is_valid")
  validationResult   Json?    @map("validation_result")
  ballsWhenRequested Int?     @map("balls_when_requested")
  requestLatencyMs   Int?     @map("request_latency_ms")
  isWinner           Boolean  @default(false) @map("is_winner")
  winnerRank         Int?     @map("winner_rank")
  requestedAt        DateTime @default(now()) @map("requested_at")
  serverTimestamp    DateTime @default(now()) @map("server_timestamp")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([userId])
  @@index([serverTimestamp])
  @@index([gameId, isValid, serverTimestamp])
  @@map("bingo_requests")
}

// ------------------------------------------
// Support Tables
// ------------------------------------------

model BotConfig {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  botUserId             String   @unique @map("bot_user_id") @db.Uuid
  maxCardsPerGame       Int      @default(2) @map("max_cards_per_game")
  maxWinRatePercent     Decimal  @default(30.00) @map("max_win_rate_percent") @db.Decimal(5, 2)
  maxConsecutiveWins    Int      @default(2) @map("max_consecutive_wins")
  minDelayMs            Int      @default(500) @map("min_delay_ms")
  maxDelayMs            Int      @default(2000) @map("max_delay_ms")
  dailyBudget           Decimal  @default(1000.00) @map("daily_budget") @db.Decimal(10, 2)
  currentDailySpent     Decimal  @default(0.00) @map("current_daily_spent") @db.Decimal(10, 2)
  totalGamesPlayed      Int      @default(0) @map("total_games_played")
  totalWins             Int      @default(0) @map("total_wins")
  totalLosses           Int      @default(0) @map("total_losses")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  botUser User @relation(fields: [botUserId], references: [id], onDelete: Cascade)

  @@index([botUserId])
  @@index([isActive])
  @@map("bot_configs")
}

model ChatMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  messageType String   @default("text") @map("message_type")
  content     String
  metadata    Json?
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([createdAt(sort: Desc)])
  @@map("chat_messages")
}

// ------------------------------------------
// System Tables
// ------------------------------------------

model AuditLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  userRole   UserRole? @map("user_role")
  action     String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  oldValue   Json?     @map("old_value")
  newValue   Json?     @map("new_value")
  metadata   Json?
  ipAddress  String?   @map("ip_address") @db.Inet
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}

model SchemaMigration {
  version     String   @id
  description String?
  appliedAt   DateTime @default(now()) @map("applied_at")

  @@map("schema_migrations")
}

// ------------------------------------------
// Achievement System
// ------------------------------------------

model Achievement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  name        String
  description String
  iconUrl     String?  @map("icon_url")
  pointReward Decimal  @default(0) @map("point_reward") @db.Decimal(10, 2)
  category    String   @default("general")
  threshold   Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  
  userAchievements UserAchievement[]
  
  @@index([category])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  unlockedAt    DateTime @default(now()) @map("unlocked_at")
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ------------------------------------------
// Referral System
// ------------------------------------------

model Referral {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId           String   @map("referrer_id") @db.Uuid
  refereeId            String   @unique @map("referee_id") @db.Uuid
  signupRewardPaid     Boolean  @default(false) @map("signup_reward_paid")
  activityRewardPaid   Boolean  @default(false) @map("activity_reward_paid")
  refereeGamesPlayed   Int      @default(0) @map("referee_games_played")
  totalRewardEarned    Decimal  @default(0) @map("total_reward_earned") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  
  referrer User @relation("ReferrerRecords", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("RefereeRecords", fields: [refereeId], references: [id], onDelete: Cascade)
  
  @@index([referrerId])
  @@map("referrals")
}
