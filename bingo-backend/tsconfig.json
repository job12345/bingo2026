{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"],
      "@auth/*": ["src/auth/*"],
      "@users/*": ["src/users/*"],
      "@wallet/*": ["src/wallet/*"],
      "@rooms/*": ["src/rooms/*"],
      "@game/*": ["src/game/*"],
      "@websocket/*": ["src/websocket/*"],
      "@admin/*": ["src/admin/*"],
      "@bot/*": ["src/bot/*"],
      "@common/*": ["src/common/*"]
    }
  }
}
