# ==========================================
# Bingo Party Enterprise - Environment Variables
# ==========================================

# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=8001
WEBSOCKET_PORT=8002

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/bingo_party?schema=public"

# ==========================================
# Redis (Caching & Queue)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8001/auth/google/callback

# ==========================================
# Frontend URL (CORS)
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# System Configuration
# ==========================================
DEFAULT_FEE_PERCENTAGE=10.00
MAX_WITHDRAW_PER_DAY=50000.00
MIN_WITHDRAW_AMOUNT=100.00
MAX_DEPOSIT_PER_DAY=100000.00

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_BINGO_PER_MINUTE=10
RATE_LIMIT_BUY_CARD_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30

# ==========================================
# Ghost Bot Configuration
# ==========================================
BOT_ENABLED=true
BOT_MIN_PLAYERS_TRIGGER=3
BOT_MAX_WIN_RATE=30.00
BOT_MAX_CONSECUTIVE_WINS=2
BOT_MIN_DELAY_MS=500
BOT_MAX_DELAY_MS=2000

# ==========================================
# File Upload (สำหรับ Payment Slip)
# ==========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug

# ==========================================
# Security
# ==========================================
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-key

# ==========================================
# Email (สำหรับ Notifications - Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# ==========================================
# Telegram (สำหรับ Notifications - Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id-or-channel-id

# ==========================================
# Sentry (Error Tracking - Optional)
# ==========================================
SENTRY_DSN=
