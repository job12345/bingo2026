# =============================================================================
# 🎯 Bingo Party Enterprise - Environment Variables Template
# =============================================================================
# คำแนะนำ: คัดลอกไฟล์นี้เป็น .env และแก้ไขค่าให้เหมาะสม
# Command: cp .env.example .env
# =============================================================================

# =============================================================================
# 🌍 Environment
# =============================================================================
NODE_ENV=development
# Options: development | staging | production

# =============================================================================
# 🔌 Server Configuration
# =============================================================================
# REST API Port (ห้ามชนกับเว็บอื่น!)
API_PORT=8001

# WebSocket Port
WS_PORT=8002

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# 🗄️ Database (PostgreSQL)
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/bingo_party?schema=public"

# Connection Pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =============================================================================
# 📦 Redis (Cache & Queue)
# =============================================================================
REDIS_URL="redis://:redis_dev_password@localhost:6379"

# Redis TTL (seconds)
REDIS_CACHE_TTL=60

# =============================================================================
# 🔐 Authentication (Google OAuth)
# =============================================================================
# 📌 สร้างได้ที่: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=869471917882-31anhrf0roojg8lffblvsm7g17f4f0ng.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:8001/auth/google/callback

# =============================================================================
# 🔑 JWT Configuration
# =============================================================================
# 🚨 สำคัญ! ใช้ Secret Key ที่รันดอมสำหรับ Production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=15m
# Options: 15m | 1h | 24h

# Refresh Token
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production
REFRESH_TOKEN_EXPIRATION=7d
# Options: 7d | 30d

# =============================================================================
# 📁 File Upload
# =============================================================================
# Payment Slip Upload Directory
UPLOAD_DIR=./uploads

# Max File Size (bytes)
MAX_FILE_SIZE=5242880
# 5 MB = 5242880 bytes

# Allowed File Types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg

# =============================================================================
# 💰 Payment Configuration
# =============================================================================
# Minimum Deposit/Withdraw (THB)
MIN_DEPOSIT_AMOUNT=100
MIN_WITHDRAW_AMOUNT=100

# Maximum Deposit/Withdraw per Day (THB)
MAX_DEPOSIT_PER_DAY=100000
MAX_WITHDRAW_PER_DAY=50000

# Default Fee Percentage
DEFAULT_FEE_PERCENTAGE=10.00

# =============================================================================
# 🎮 Game Configuration
# =============================================================================
# Auto Draw Interval (milliseconds)
AUTO_DRAW_INTERVAL_MS=5000
# 5 seconds = 5000 ms

# Sitting Phase Duration (seconds)
SITTING_PHASE_DURATION=30

# Buying Phase Duration (seconds)
BUYING_PHASE_DURATION=20

# Cooldown Duration (seconds)
COOLDOWN_DURATION=10

# =============================================================================
# 🤖 Bot Configuration
# =============================================================================
BOT_ENABLED=true

# Minimum Players Before Bot Joins
BOT_MIN_PLAYERS_TRIGGER=3

# Bot Max Win Rate (%)
BOT_MAX_WIN_RATE=30.00

# =============================================================================
# 🚦 Rate Limiting
# =============================================================================
# Global Rate Limit (requests per minute)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Bingo Request Rate Limit (per minute)
BINGO_RATE_LIMIT=10

# Card Purchase Rate Limit (per minute)
BUY_CARD_RATE_LIMIT=20

# Chat Message Rate Limit (per minute)
CHAT_RATE_LIMIT=30

# =============================================================================
# 📧 Email (Optional - สำหรับแจ้งเตือน)
# =============================================================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Bingo Party <noreply@bingoparty.com>

# =============================================================================
# 🔍 Monitoring & Logging
# =============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log Level
LOG_LEVEL=debug
# Options: debug | info | warn | error

# =============================================================================
# 🏗️ Development Tools
# =============================================================================
# Enable Swagger API Documentation
ENABLE_SWAGGER=true

# Enable Debug Mode
DEBUG=true

# =============================================================================
# 🚀 Production Only
# =============================================================================
# (ใช้เฉพาะ Production - อย่าเปิดใน Development)

# SSL/TLS
# ENABLE_HTTPS=true
# SSL_KEY_PATH=/path/to/ssl/key.pem
# SSL_CERT_PATH=/path/to/ssl/cert.pem

# Session Secret
# SESSION_SECRET=your-session-secret-change-this-in-production

# =============================================================================
# 📊 Database Backup (Production)
# =============================================================================
# Backup Schedule (Cron Expression)
# BACKUP_SCHEDULE=0 3 * * *
# 0 3 * * * = ทุกวัน เวลา 03:00 น.

# Backup Destination
# BACKUP_DIR=/backups
# BACKUP_S3_BUCKET=my-backup-bucket

# =============================================================================
# 🌐 CDN & Assets (Production)
# =============================================================================
# CDN URL for Static Assets
# CDN_URL=https://cdn.bingoparty.com

# S3 Bucket for Uploads
# S3_BUCKET=bingo-party-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

# =============================================================================
# 🔔 Notifications (Production)
# =============================================================================
# Slack Webhook for Alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# =============================================================================
# 📝 Notes
# =============================================================================
# 1. อย่าเผยแพร่ไฟล์ .env (เพิ่มใน .gitignore)
# 2. ใช้ Secret Manager ใน Production (AWS Secrets Manager, HashiCorp Vault)
# 3. Rotate Secrets ทุก 90 วัน
# 4. ใช้ Strong Password สำหรับ Database & Redis
# 5. เปิด HTTPS บน Production เสมอ
# =============================================================================
